# zip-buildserver local configuration

# Change this before exposing the service.
ZIP_BUILDSERVER_API_TOKEN=change-me

# HTTP ports exposed by Docker Compose.
BACKEND_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# PostgreSQL defaults for local Docker Compose development.
POSTGRES_DB=zip_buildserver
POSTGRES_USER=zip_buildserver
POSTGRES_PASSWORD=zip_buildserver

# Local storage defaults used by the backend container.
ZIP_BUILDSERVER_DATA_DIR=/data/zip-buildserver
